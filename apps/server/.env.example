DATABASE_URL="postgresql://postgres:password@localhost:5432/nextpannel"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
ENCRYPTION_KEY="32-char-hex-key-change-in-prod!!"
PORT=3001
# Set false to pause durable deletion workers during rollout/rollback.
RESOURCE_CLEANUP_ENABLED=true
# Read-only background inventory; explicit owner-triggered scans remain available.
RESOURCE_INVENTORY_ENABLED=true
# Separate authenticated CF probe v2; never point this at the legacy GFW function.
CF_OPTIMIZATION_ENABLED=false
# Independent XHTTP+TLS CDN pilot. Never migrates existing WS nodes.
CF_XHTTP_PILOT_ENABLED=false
CF_OPTIMIZATION_PROBES='[]'
# Low-budget pilot: two rounds every eight hours, global UTC-month batch cap.
CF_OPTIMIZATION_LOW_BUDGET=true
CF_OPTIMIZATION_MAX_MONTHLY_BATCHES=200
# Continuous mode only (LOW_BUDGET=false): 5/10/15/20/30 minutes. Review the cap first.
# Approved Guangzhou + Chengdu rollout uses 15 minutes and 25000 batches; see docs/CF-PROBE-BUDGET.md.
CF_OPTIMIZATION_INTERVAL_MINUTES=5
# Opt-in server-side identity traffic; requires migration, Agent 1.8+, and explicit node preparation.
USAGE_OBSERVATION_ENABLED=false
ALLOWED_ORIGIN="http://localhost:3400"
PANEL_URL="https://your-panel-domain.com"
PANEL_DIRECT_URL="http://your-panel-ip:3001"
GITHUB_REPO="your-github-username/nextpanel"
